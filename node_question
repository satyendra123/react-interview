import express from 'express';

const app = express();
const port = 5000;

app.get('/get_user', async (req, res) => {

    try {
        const users = await Users.getAll();
        if (users) {
            res.json({data: users, msg: "Data fetched successfully"});
        } 
        else {
            res.status(404).json({err: "No users found"});
        }
    } 

    catch (e) {
        console.log(e);
        res.status(500).json({err: "Server error", message: e.message});
    }
});

app.listen(port, () => {
    console.log(`Server is running on port ${port}`);
});
