import { useState, useRef } from "react";

const App = () => {
  const [otp, setOtp] = useState({
    input1: "",
    input2: "",
    input3: "",
    input4: "",
  });

  const input1ref = useRef();
  const input2ref = useRef();
  const input3ref = useRef();
  const input4ref = useRef();

  const handleOnchange = (e) => {
    const data = e.target.name;
    const value = e.target.value;

    if (!/^[0-9]?$/.test(value)) {
      return;
    }

    if (value.length > 1) {
      return;
    }

    setOtp({ ...otp, [data]: value });

    // NEXT AUTO FOCUS
    if (value !== "") {
      if (data == "input1") {
        input2ref.current.focus();
      } else if (data == "input2") {
        input3ref.current.focus();
      } else if (data == "input3") {
        input4ref.current.focus();
      }
    }
  };

  // BACKSPACE LOGIC
  const handleKeyDown = (e) => {
    const data = e.target.name;
    const value = e.target.value;

    if (e.key === "Backspace" && value === "") {
      if (data === "input2") {
        input1ref.current.focus();
      } else if (data === "input3") {
        input2ref.current.focus();
      } else if (data === "input4") {
        input3ref.current.focus();
      }
    }
  };

  return (
    <>
      <h1>OTP VALIDATION</h1>

      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          gap: "15px",
        }}
      >
        <input
          type="text"
          name="input1"
          ref={input1ref}
          value={otp.input1}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input2"
          ref={input2ref}
          value={otp.input2}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input3"
          ref={input3ref}
          value={otp.input3}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input4"
          ref={input4ref}
          value={otp.input4}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />
      </div>

      <p>{JSON.stringify(otp)}</p>
    </>
  );
};

export default App;

note- the above approach is not that much scalable. instead of that use this method

import { useState, useRef } from "react";

const App = () => {
  const [otp, setOtp] = useState(["", "", "", ""]);
  const inputRef = useRef([]);

  const handleChange = (e, index) => {
    const value = e.target.value;

    // allow only single digit
    if (!/^[0-9]?$/.test(value)) {
      return;
    }

    const newOtp = [...otp];
    newOtp[index] = value;

    setOtp(newOtp);

    // move to next input
    if (value && index < otp.length - 1) {
      inputRef.current[index + 1].focus();
    }
  };

  const handlekeypress = (e, index) => {
    // move back on backspace
    if (e.key === "Backspace" && !otp[index] && index > 0) {
      inputRef.current[index - 1].focus();
    }
  };

  return (
    <>
      <h1>OTP VERIFICATION</h1>

      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          gap: "10px",
        }}
      >
        {[0, 1, 2, 3].map((item, index) => (
          <input
            key={index}
            ref={(el) => (inputRef.current[index] = el)}
            type="text"
            maxLength={1}
            value={otp[index]}
            style={{
              height: "30px",
              width: "45px",
              textAlign: "center",
              fontSize: "20px",
            }}
            onChange={(e) => handleChange(e, index)}
            onKeyDown={(e) => handlekeypress(e, index)}
          />
        ))}
      </div>

      <h2>OTP: {otp.join("")}</h2>
    </>
  );
};

export default App;
