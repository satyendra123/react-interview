import { useState, useRef } from "react";

const App = () => {
  const [otp, setOtp] = useState({
    input1: "",
    input2: "",
    input3: "",
    input4: "",
  });

  const input1ref = useRef();
  const input2ref = useRef();
  const input3ref = useRef();
  const input4ref = useRef();

  const handleOnchange = (e) => {
    const data = e.target.name;
    const value = e.target.value;

    if (!/^[0-9]?$/.test(value)) {
      return;
    }

    if (value.length > 1) {
      return;
    }

    setOtp({ ...otp, [data]: value });

    // NEXT AUTO FOCUS
    if (value !== "") {
      if (data == "input1") {
        input2ref.current.focus();
      } else if (data == "input2") {
        input3ref.current.focus();
      } else if (data == "input3") {
        input4ref.current.focus();
      }
    }
  };

  // BACKSPACE LOGIC
  const handleKeyDown = (e) => {
    const data = e.target.name;
    const value = e.target.value;

    if (e.key === "Backspace" && value === "") {
      if (data === "input2") {
        input1ref.current.focus();
      } else if (data === "input3") {
        input2ref.current.focus();
      } else if (data === "input4") {
        input3ref.current.focus();
      }
    }
  };

  return (
    <>
      <h1>OTP VALIDATION</h1>

      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          gap: "15px",
        }}
      >
        <input
          type="text"
          name="input1"
          ref={input1ref}
          value={otp.input1}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input2"
          ref={input2ref}
          value={otp.input2}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input3"
          ref={input3ref}
          value={otp.input3}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />

        <input
          type="text"
          name="input4"
          ref={input4ref}
          value={otp.input4}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
          onKeyDown={handleKeyDown}
        />
      </div>

      <p>{JSON.stringify(otp)}</p>
    </>
  );
};

export default App;

note- the above approach is not that much scalable. instead of that use this method

import { useState, useRef } from "react";

const App = () => {
const [otp,setOtp] = useState(["", "", "", ""]);

  const inputRefs = useRef([]);

  const handleChange = (e, index) => {
    const value = e.target.value;
    if (!/^[0-9]?$/.test(value)) {
      return;
    }
    const newarr = [...otp];
    newarr[index] = value;
    setOtp(newarr);

    if (value && index < otp.length - 1) {
      inputRefs.current[index + 1].focus();
    }
  };

const handlekeypress = (e, index) => {
  if (e.key === "Backspace" && otp[index] === "" && index > 0) {
    inputRefs.current[index - 1].focus();
  }
};

  return (
    <>
      <h1>OTP VERIFICATION</h1>
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          gap: "10px",
        }}
      >
        {[1, 2, 3, 4].map((item, index) => (
          <input
            key={index}
            type="text"
            maxLength={1}
            ref={(el) => (inputRefs.current[index] = el)}
            
        style={{ height: "30px", width: "45px" }}
        onChange={(e) => {
              handleChange(e, index);
            }}
            onKeyDown={(e) => {
              handlekeypress(e, index);
            }}
          />
        ))}
      </div>
    </>
  );
};
export default App;

Note- Bahut achha question hai. Ye samajh jaoge to useRef([]) ka concept clear ho jayega.

Agar tum manually 4 refs banao:

const inputRef1 = useRef();
const inputRef2 = useRef();
const inputRef3 = useRef();
const inputRef4 = useRef();

Aur inputs me:

<input ref={inputRef1} />
<input ref={inputRef2} />
<input ref={inputRef3} />
<input ref={inputRef4} />

To React automatically DOM elements assign kar deta hai:

inputRef1.current = firstInputElement;
inputRef2.current = secondInputElement;
inputRef3.current = thirdInputElement;
inputRef4.current = fourthInputElement;

Bahut repetitive code ho jayega. Isliye hum ek hi ref banate hain:

const inputRef = useRef([]);

Ab ye sirf ek object hai:

inputRef = {
  current: []
}

Initially:

inputRef.current = [];

Jab first input render hota hai:

ref={(el) => (inputRef.current[0] = el)}
