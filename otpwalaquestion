import { useState } from "react";
const App = () => {
  const [otp, setOtp] = useState({
    input1: "",
    input2: "",
    input3: "",
    input4: "",
  });

  const handleOnchange = (e) => {
    const data = e.target.name;
    const value = e.target.value;

    if (!/^[0-9]?$/.test(value)) {
      return;
    }

    if (value.length > 1) {
      return;
    }

    setOtp({ ...otp, [data]: value });
  };

  return (
    <>
      <h1>OTP VALIDATION</h1>
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          gap: "15px",
        }}
      >
        <input
          type="text"
          name="input1"
          value={otp.input1}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
        />
        <input
          type="text"
          name="input2"
          value={otp.input2}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
        />
        <input
          type="text"
          name="input3"
          value={otp.input3}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
        />
        <input
          type="text"
          name="input4"
          value={otp.input4}
          maxLength={1}
          style={{
            width: "50px",
            height: "35px",
            borderRadius: "7px",
            border: "2px solid black",
          }}
          onChange={handleOnchange}
        />
      </div>
      <p>{JSON.stringify(otp)}</p>
    </>
  );
};
export default App;
